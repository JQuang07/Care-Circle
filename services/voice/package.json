{
  "name": "@care-circle/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "latency": "tsx --env-file-if-exists=.env src/latency.ts",
    "format": "prettier --write src test docs README.md package.json tsconfig.json",
    "format:check": "prettier --check src test docs README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.2.0",
    "@livekit/rtc-node": "^1.1.0",
    "fastify": "^5.6.0",
    "livekit-server-sdk": "^2.15.0",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "twilio": "^5.10.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
