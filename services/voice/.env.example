# Start here: no paid providers or neighboring services required.
MOCK=1
MOCK_DEPENDENCIES=1
PORT=4001
HOST=127.0.0.1
CC_INTERNAL_SECRET=replace-with-a-long-random-shared-secret
MONEY_URL=http://localhost:4002
FAMILY_URL=http://localhost:4003
# Live mode requires Postgres; only schema voice is created/written.
DATABASE_URL=
META_API_KEY=
MUSE_MODEL=muse-spark-1.3
STT_PROVIDER=fallback
DEEPGRAM_API_KEY=
TTS_PROVIDER=deepgram
TTS_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
PUBLIC_BASE_URL=https://your-tunnel.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Only these seniors may call inbound; phone is resolved from family service.
SENIOR_IDS=sen_rose
# Required in live mode: comma-separated consenting adult test phone numbers.
DIAL_ALLOWLIST=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
# Set tablet to return a clear Plan B result; reminders still use Twilio.
FAMILY_CALL_TRANSPORT=sip
