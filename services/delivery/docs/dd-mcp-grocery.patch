+/**
+ * Empty the cart: open the drawer and press each row's remove button (at quantity 1 the
+ * stepper's decrement removes the row). For re-running dry runs; a person asks for it.
+ */
+export async function clearCart(): Promise<{ success: boolean; removed?: number; remaining?: number; page?: string; error?: string }> {
+  const p = await getPage();
+  const ctx = await getContext();
+  try {
+    // Checkout/aisle pages don't host the drawer; otherwise stay put (a reload's redirect
+    // would close the drawer we are about to open).
+    await ensureOnDoorDash(p);
+    if (/checkout/i.test(p.url())) {
+      await p.goto(DOORDASH_BASE_URL, { waitUntil: "load", timeout: DEFAULT_TIMEOUT });
+      await p.waitForTimeout(4000);
+    }
+    const row = '[data-testid="OrderCart"] [data-anchor-id="OrderCartItem"]';
+    const openDrawer = async () => {
+      await p.keyboard.press("Escape").catch(() => {});
+      await p.locator('[data-testid="OrderCartIconButton"]').first().click({ timeout: 10000 });
+      await p.locator(row).first().waitFor({ timeout: 8000 }).catch(() => {});
+    };
+    await openDrawer();
+    if (!(await p.locator(row).count())) await openDrawer(); // one retry
+    let removed = 0;
+    for (let i = 0; i < 60; i++) {
+      if (!(await p.locator(row).count().catch(() => 0))) break;
+      await p.locator('[data-testid="OrderCart"] [data-testid="stepper-decrement-button"]').first().click({ timeout: 5000 });
+      removed++;
+      await p.waitForTimeout(1000);
+    }
+    const iconLabel = await p.locator('[data-testid="OrderCartIconButton"]').first().getAttribute("aria-label").catch(() => null);
+    const remaining = iconLabel ? Number(/^(\d+) item/.exec(iconLabel)?.[1] ?? NaN) : undefined;
+    await p.keyboard.press("Escape").catch(() => {});
+    await saveCookies(ctx);
+    return { success: remaining === undefined || remaining === 0, removed, remaining, page: p.url() };
+  } catch (error) {
+    return { success: false, error: error instanceof Error ? error.message : "Failed to clear cart" };
+  }
+}
