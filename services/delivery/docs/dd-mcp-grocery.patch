+/**
+ * Grocery and convenience stores redirect /store/:id to /convenience/store/:id and
+ * render products as retail cards whose aria-label reads "$1.69 , Name , 1 gallon".
+ * The visible price is split into separate spans, so the restaurant parser misses it.
+ */
+const RETAIL_CARD = '[data-testid="RetailItemCardCardContent"]';
+export const isRetailUrl = (url: string) => url.includes("/convenience/store/");
+
+/** Parses a retail card's aria-label: "$1.69 , Kroger Whole Milk , 1 gallon". */
+export function parseRetailLabel(label: string): { name: string; price: number; size: string } | null {
+  const parts = label.split(" , ").map((s) => s.trim());
+  const price = /^\$(\d+(?:\.\d{1,2})?)$/.exec(parts[0] ?? "");
+  if (!price || !parts[1]) return null;
+  return { price: parseFloat(price[1]), name: parts[1], size: parts.slice(2).join(", ") };
+}
+
+/** The cart icon and checkout only exist on DoorDash pages; a fresh tab is about:blank. */
+async function ensureOnDoorDash(p: Page): Promise<void> {
+  if (p.url().includes("doordash.com")) return;
+  await p.goto(DOORDASH_BASE_URL, { waitUntil: "domcontentloaded", timeout: DEFAULT_TIMEOUT });
+  await p.waitForTimeout(3000);
+}
+
+/** Types a query into the store's own "Search <store>" box and waits for result cards. */
+async function searchInStore(p: Page, query: string): Promise<void> {
+  const box = p.getByRole("searchbox", { name: /Search/i }).first();
+  await box.waitFor({ timeout: 10000 });
+  // The store home page uses the same cards, so wait for the list to change, then settle.
+  const snapshot = () =>
+    p.locator(RETAIL_CARD).evaluateAll((els) => els.map((e) => e.getAttribute("aria-label") || "").join("|"));
+  const before = await snapshot();
+  await box.click();
+  await box.fill("");
+  await box.fill(query);
+  await box.press("Enter");
+  // Lazy-loading home carousels also change the list, so "results arrived" means a card
+  // names one of the query's words (roughly stemmed) and the list has stopped changing.
+  const words = query.toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length >= 3)
+    .map((w) => (w.length > 4 && w.endsWith("es") ? w.slice(0, -2) : w.endsWith("s") ? w.slice(0, -1) : w));
+  const relevant = (s: string) => !words.length || words.some((w) => s.toLowerCase().includes(w));
+  let last = before;
+  let stable = 0;
+  for (let waited = 0; waited < 20000 && stable < 2; waited += 700) {
+    await p.waitForTimeout(700);
+    const now = await snapshot();
+    stable = now && now !== before && relevant(now) && now === last ? stable + 1 : 0;
+    last = now;
+  }
+}
+
+async function readRetailItems(p: Page, restaurantId: string, limit = 20): Promise<MenuItem[]> {
+  const labels = await p.locator(RETAIL_CARD).evaluateAll((els) =>
+    els.map((e) => e.getAttribute("aria-label") || "")
+  );
+  const items: MenuItem[] = [];
+  const seen = new Set<string>();
+  for (const label of labels) {
+    const parsed = parseRetailLabel(label);
+    if (!parsed || seen.has(parsed.name)) continue;
+    seen.add(parsed.name);
+    items.push({ id: `${restaurantId}-r${items.length}`, name: parsed.name, description: parsed.size, price: parsed.price });
+    if (items.length >= limit) break;
+  }
+  return items;
+}
