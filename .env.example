# Copy to .env at the repo root:   copy .env.example .env   (Windows)   cp .env.example .env   (mac/linux)
# Do NOT set PORT here: each service has its own fixed port (voice 4001, money 4002, family 4003, web 3000).

MOCK=1

# Must be identical for the whole team and at least 24 characters (voice refuses to start otherwise).
CC_INTERNAL_SECRET=replace-with-the-team-shared-secret-24chars+

# Postgres from docker-compose.yml (docker compose up -d --wait)
DATABASE_URL=postgres://cc:cc@localhost:5432/care_circle

VOICE_URL=http://localhost:4001
MONEY_URL=http://localhost:4002
FAMILY_URL=http://localhost:4003
WEB_URL=http://localhost:3000

# Muse (dev.meta.ai). Use muse-spark-1.3, never the "-contributor" tier.
META_API_KEY=
MUSE_MODEL=muse-spark-1.3

# LiveKit: local dev server (docker) uses devkey/secret; or a LiveKit Cloud project.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Voice (Agent 1). See services/voice/.env.example for the full list.
STT_PROVIDER=fallback
TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
PUBLIC_BASE_URL=

# Neighbor services: 0 = call the real voice/money/family/delivery over HTTP (team default)
MOCK_DEPENDENCIES=0

# Money (Agent 2)
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=

# Delivery (Agent 3) · docs/CONTRACTS-ADDENDUM.md D14. Keep mock + dry run unless you're on the demo laptop.
DELIVERY_URL=http://localhost:4004
DELIVERY_PROVIDER=mock
DOORDASH_LIVE_CHECKOUT=0
DOORDASH_MAX_ORDER_CENTS=3000
DOORDASH_PRICE_TOLERANCE_PCT=10
# Third-party DoorDash MCP server (runs OUTSIDE the repo on the demo laptop; see services/delivery/README.md)
DOORDASH_MCP_URL=http://127.0.0.1:3100/mcp
DOORDASH_MCP_TOKEN=
# Address the DoorDash account delivers to (a teammate's, standing in for "Rose's house")
DOORDASH_DROPOFF_ADDRESS=
# What to search for when shopping groceries (a store name near that address works best)
DOORDASH_GROCERY_STORE=grocery
